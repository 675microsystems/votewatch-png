# Copy to .env.local. Use the anon/public key ONLY, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Shown on /privacy and /terms. Set the reviewed flag only after a lawyer has approved the wording.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_REVIEWED=false

# Optional CAPTCHA (Cloudflare Turnstile). Public site key only; the secret key goes in Supabase, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
